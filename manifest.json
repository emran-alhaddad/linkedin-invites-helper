{
  "manifest_version": 3,
  "name": "LinkedIn Invites Helper",
  "version": "1.2.0",
  "description": "Accept or ignore all your LinkedIn invitations in one click, at a safe human pace.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/mynetwork/grow/*",
        "https://www.linkedin.com/mynetwork/invitation-manager/received/*"
      ],
      "js": ["core.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
